# Replace with your PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/queue_system?schema=public"

# Direct connection for Prisma migrations (often required alongside pooled DATABASE_URL)
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/queue_system?schema=public"

# Supabase project settings (Project Settings -> API)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
# Server-only. Never expose to the frontend — bypasses Row Level Security / Auth checks.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Server
PORT=3000
NODE_ENV="development"

# Comma-separated list of frontend origins allowed for HTTP CORS + Socket.IO CORS.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# --- Supabase dashboard (Google OAuth only) ---
# 1. Authentication → Providers → Google: enabled
# 2. Authentication → URL Configuration: add redirect URLs, e.g.
#    http://localhost:5173/auth/callback
#    https://your-production-domain/auth/callback
# 3. Authentication → Providers → Email: disable sign-ups (or disable email provider entirely)
#
# [email/password — disabled] EMAIL_CONFIRM_REDIRECT_TO is unused while Google-only auth is active.
# EMAIL_CONFIRM_REDIRECT_TO="http://localhost:5173/auth/callback?type=signup"
