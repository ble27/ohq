{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://queueble.onrender.com/api/:path*"
    },
    {
      "source": "/((?!favicon\\.ico|favicon\\.svg|favicon-32\\.png|apple-touch-icon\\.png|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
