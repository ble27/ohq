{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.queueble.app" }],
      "destination": "https://queueble.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://queueble.onrender.com/api/:path*"
    },
    {
      "source": "/((?!favicon\\.ico|favicon\\.svg|favicon-32\\.png|apple-touch-icon\\.png|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
