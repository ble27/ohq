# Supabase project settings (Project Settings -> API)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Backend API base URL. In dev, leave unset to use the Vite proxy
# (see vite.config.ts) which forwards /api to http://localhost:3000.
# In production, set this to your deployed backend URL, e.g.
# https://your-backend.onrender.com
VITE_API_URL="http://localhost:3000"
