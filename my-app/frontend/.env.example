# Supabase project settings (Project Settings -> API)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Backend WebSocket host (Socket.IO). REST /api calls use same-origin paths
# and are proxied (Vite in dev, Vercel rewrites in prod) so auth cookies stay
# first-party — do NOT point axios at this URL in production.
# Dev:
VITE_API_URL="http://localhost:3000"
# Prod (Vercel env):
# VITE_API_URL="https://queueble.onrender.com"
