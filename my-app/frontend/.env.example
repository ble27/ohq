# Supabase project settings (Project Settings -> API)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Backend WebSocket host (Socket.IO) — **production only**.
# REST /api calls use same-origin paths (Vite proxy in dev, Vercel rewrites in prod).
# In dev, sockets also use same-origin; Vite proxies /socket.io → localhost:3000,
# so this value is ignored locally even if set to Render.
# Prod (Vercel env):
VITE_API_URL="https://queueble.onrender.com"
